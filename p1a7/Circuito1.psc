Algoritmo Circuito1
	Definir p,q Como Logico
	
	p <- Verdadero
	q <- Verdadero
	
	Escribir p,"-",q,"-",p y q,"-", no q, "-", (p y q) o (no q)
	
	p <- Verdadero
	q <- falso 
	
	Escribir p,"-",q,"-",p y q,"-", no q, "-", (p y q) o (no q)
	
	p <- falso
	q <- Verdadero
	
	Escribir p,"-",q,"-",p y q,"-", no q, "-", (p y q) o (no q)
	
	p <- falso
	q <- falso
	
	Escribir p,"-",q,"-",p y q,"-", no q, "-", (p y q) o (no q)
	
FinAlgoritmo
